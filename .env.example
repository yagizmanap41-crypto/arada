# Bu dosyanın adını ".env" yapıp kendi değerlerinizi yazın.
# ".env" dosyasını GitHub'a YÜKLEMEYİN.
SECRET_KEY=buraya-uzun-rastgele-bir-yazi-yazin
GROQ_API_KEY=gsk_buraya-groq-anahtarinizi-yapistirin
GROQ_MODEL=openai/gpt-oss-20b
# Yönetim panelinin şifresi (leads listesini görmek için gerekir)
ADMIN_KEY=kendi-belirleyeceginiz-bir-sifre
# Geliştirme için * kalabilir; yayında Wix adresinizi yazın (örn. https://kullanici.wixsite.com)
CORS_ORIGINS=*
# Yayında (Render) production yapın
APP_ENV=development
